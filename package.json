{
  "name": "productivity-os-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "app:build": "zsh scripts/build-macos-app.sh",
    "app:open": "open '.build/personal-os-macos/Personal OS.app'",
    "app:refresh": "npm run build && npm run app:build",
    "assistant": "node scripts/start-assistant.mjs",
    "test:assistant": "node --test scripts/assistant.test.cjs scripts/assistant-planning.test.cjs && python3 -B scripts/hermes-history.test.py",
    "test:economy": "node --test scripts/economy.test.cjs",
    "test:timer": "node --test scripts/timer-runtime.test.cjs",
    "test:tasks": "node --test scripts/task-library.test.cjs",
    "test:day": "node --test scripts/activity-day.test.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test:assistant:db": "node scripts/assistant-db.test.cjs",
    "test:assistant:live": "node scripts/assistant-hermes.smoke.cjs"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
